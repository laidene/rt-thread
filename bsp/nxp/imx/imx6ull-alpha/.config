#
# Select SPI Driver
#
CONFIG_BSP_USING_SPI=y
CONFIG_BSP_USING_SPI1=y
# CONFIG_BSP_USING_SPI2 is not set
CONFIG_BSP_USING_SPI3=y
# CONFIG_BSP_USING_SPI4 is not set
# end of Select SPI Driver

#
# Select I2C Driver
#
CONFIG_BSP_USING_I2C=y
CONFIG_BSP_USING_I2C1=y
CONFIG_I2C1_BAUD_RATE=100000
# CONFIG_BSP_USING_I2C2 is not set
# CONFIG_BSP_USING_I2C3 is not set
# CONFIG_BSP_USING_I2C4 is not set
# end of Select I2C Driver

#
# Select LCD Driver
#
# CONFIG_BSP_USING_LCD is not set
# end of Select LCD Driver

#
# Select SDHC Driver
#
CONFIG_RT_USING_SDIO1=y
CONFIG_RT_USING_SDIO2=y
# end of Select SDHC Driver

#
# Select RTC Driver
#
CONFIG_BSP_USING_ONCHIP_RTC=y
# end of Select RTC Driver

#
# Select PWM Driver
#
# end of Select PWM Driver

#
# Select ADC Driver
#
# end of Select ADC Driver

#
# Select WDT Driver
#
# end of Select WDT Driver

#
# Select ENET Driver
#
CONFIG_RT_USING_ENET1=y
# CONFIG_RT_USING_ENET2 is not set
# end of Select ENET Driver

#
# Select Wifi Driver
#
# CONFIG_RT_USING_WIFI_RW007 is not set
# end of Select Wifi Driver

#
# Select USB Driver
